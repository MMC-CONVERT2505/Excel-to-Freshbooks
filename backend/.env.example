# ── App ────────────────────────────────────────────────────────────────────────
PORT=1073

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev:   postgresql://appuser:yourpassword@localhost:5432/qbd_freshbooks
# Docker:      postgresql://appuser:yourpassword@db:5432/qbd_freshbooks  (host = "db")
DATABASE_URL=postgresql://appuser:yourpassword@localhost:5432/qbd_freshbooks

# ── Docker Compose (only needed in docker-compose.yml / EC2) ──────────────────
POSTGRES_DB=qbd_freshbooks
POSTGRES_USER=appuser
POSTGRES_PASSWORD=yourpassword

# ── Frontend URL (for OAuth redirect after login) ─────────────────────────────
FRONTEND_URL=http://localhost:1074

# ── FreshBooks OAuth ───────────────────────────────────────────────────────────
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
FRESHBOOKS_REDIRECT_URI=https://yourdomain.com/callback

# ── FreshBooks Business (set after first OAuth login) ─────────────────────────
FRESHBOOKS_ACCOUNT_ID=
FRESHBOOKS_BUSINESS_UUID=
FRESHBOOKS_BUSINESS_ID=
